# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ Gemini API key ของตัวเอง
GEMINI_API_KEY=

# เปลี่ยนชื่อโมเดลแชตได้เมื่อจำเป็น
GEMINI_MODEL=gemini-3.8-flash

# API Key สำหรับเลือกใช้ Groq เป็น AI ตอบคำถาม
GROQ_API_KEY=

# เปลี่ยนชื่อ Model Groq ได้เมื่อจำเป็น
GROQ_CHAT_MODEL=qwen/qwen3.8-27b

# API Key สำหรับ OCR เอกสารภาษาไทยจาก iApp
IAPP_API_KEY=
